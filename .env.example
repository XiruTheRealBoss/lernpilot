# Offline demo: no environment variables or credentials needed.
# Only the separate local account test environment needs this configuration.
# Copy to ignored .env.local ONLY after the local infrastructure is approved/ready.
# Never use a hosted URL or real school/student credentials.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
LERNPILOT_FRONTEND_ORIGIN=http://127.0.0.1:5174
# Never prefix keys with VITE_. The browser accesses only the same-origin API.
# Live Google/Lyceum/Apple access stays disabled regardless of these variables.
