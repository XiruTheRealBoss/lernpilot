{
  "name": "lernpilot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "vitest run --config tests/server/vitest.config.ts",
    "test:database": "node scripts/run-local-database-tests.ts",
    "test:browser:local": "node scripts/run-local-database-tests.ts ui",
    "test:infrastructure": "node --test tests/infrastructure/*.test.ts",
    "supabase:start": "node scripts/local-supabase.ts start",
    "supabase:stop": "node scripts/local-supabase.ts stop",
    "supabase:status": "node scripts/local-supabase.ts status",
    "dev:api": "node --env-file-if-exists=.env.local server/index.ts",
    "seed:local": "node --env-file-if-exists=.env.local scripts/seed-local.ts",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build",
    "build:dev": "npm run typecheck && vite build --mode development",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:dev && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "motion": "12.43.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.5.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "postcss": "8.5.33",
    "supabase": "3.4.0",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.1"
}
