// Local synthetic test stack only. Docker/WSL installation and start need separate approval.
{
  "$schema": "https://supabase.com/schemas/config/v1.json",
  "project_id": "lernpilot-integration",
  "api": {
    "enabled": true,
    "port": 54321,
    "schemas": [
      "public"
    ],
    "extra_search_path": [
      "public",
      "extensions"
    ],
    "max_rows": 100,
    "db_pool": 5,
    "auto_expose_new_tables": false,
    "tls": {
      "enabled": false
    }
  },
  "db": {
    "port": 54322,
    "shadow_port": 54320,
    "major_version": 17,
    "pooler": {
      "enabled": false
    },
    "migrations": {
      "enabled": true,
      "schema_paths": []
    },
    "seed": {
      "enabled": false,
      "sql_paths": [
        "./seed.sql"
      ]
    }
  },
  "realtime": {
    "enabled": false
  },
  "studio": {
    "enabled": false
  },
  "local_smtp": {
    "enabled": true,
    "port": 54324
  },
  "storage": {
    "enabled": false
  },
  "auth": {
    "enabled": true,
    "site_url": "http://127.0.0.1:5174",
    "additional_redirect_urls": [],
    "jwt_expiry": 300,
    "enable_refresh_token_rotation": true,
    "refresh_token_reuse_interval": 10,
    "enable_signup": true,
    "enable_anonymous_sign_ins": false,
    "enable_manual_linking": false,
    "minimum_password_length": 12,
    "rate_limit": {
      "email_sent": 2,
      "sms_sent": 30,
      "anonymous_users": 30,
      "token_refresh": 150,
      "sign_in_sign_ups": 30,
      "token_verifications": 30,
      "web3": 30
    },
    "email": {
      "enabled": true,
      "double_confirm_changes": true,
      "enable_confirmations": false,
      "secure_password_change": true
    },
    "sms": {
      "enabled": false
    }
  },
  "edge_runtime": {
    "enabled": false
  },
  "analytics": {
    "enabled": false
  }
}
